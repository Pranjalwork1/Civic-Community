# ==============================================================================
# CivicSignal Backend & Fetch.ai Coordinator Agent Environment Configuration
# KEEP THIS FILE SERVER-SIDE. NEVER COMMIT PRODUCTION SECRETS OR PRIVATE SEEDS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Security Settings
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
# Port assigned by hosting provider (Render sets $PORT automatically, default 8000 for local)
PORT=8000
BACKEND_PORT=8000

# Server-side authentication key. Protects /api/assistant/chat from unauthorized bots.
# Kept strictly server-side (or in Vercel Serverless Function Environment Variables).
BACKEND_API_KEY=replace_with_a_strong_random_secret_token

# Allowed CORS origins (comma-separated). Includes your production Vercel frontend URL.
CORS_ORIGINS=https://civic-community-wine.vercel.app,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. CivicSignal Coordinator Agent (Fetch.ai uAgents)
# ------------------------------------------------------------------------------
AGENT_NAME=civicsignal_coordinator

# Crucial: Keep this seed phrase private and constant so your agent maintains
# the exact same cryptographic address (agent1q...) across restarts and deployments.
AGENT_SEED=replace_with_your_secure_unique_seed_phrase_here
AGENT_PORT=8001

# ------------------------------------------------------------------------------
# 3. Agentverse Integration Mode:
#    Choose EITHER Public HTTPS Endpoint (Recommended for "Connect Agent" wizard)
#    OR Agentverse Mailbox (for offline polling / behind strict firewalls).
# ------------------------------------------------------------------------------
# Mode A: Public HTTPS Endpoint (for Agentverse Connect Agent wizard & register_chat_agent)
# After deploying to Render, set this to: https://<your-render-service>.onrender.com/submit
AGENT_ENDPOINT_URL=https://civicsignal-backend.onrender.com/submit

# Agentverse API Key & Automatic Registration:
# Obtain your Agentverse API Key from https://agentverse.ai -> Profile -> API Keys
# Used by register_chat_agent to register and activate civicsignal_coordinator
AGENTVERSE_KEY=
AGENTVERSE_URL=https://agentverse.ai

# If set to true, the backend will automatically register the agent on Agentverse at startup
AUTO_REGISTER_AGENTVERSE=false

# Mode B: Agentverse Mailbox
# Set AGENT_MAILBOX=true only if you are connecting via an Agentverse Mailbox key instead of a public endpoint
AGENT_MAILBOX=false

# ------------------------------------------------------------------------------
# 4. ASI:One Intelligence API
#    Obtain your API key from https://asi1.ai or Fetch.ai Innovation Lab
#    If left blank, the agent uses its built-in civic coordinator domain knowledge.
# ------------------------------------------------------------------------------
ASI_ONE_API_KEY=
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1-mini
